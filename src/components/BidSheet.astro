---
// Hero visual: a week's bid sheet. On load, rows that aren't the visitor's trade fade
// and the concrete jobs near Raleigh get flagged. Plays once; reduced motion shows the end state.
import { BIDS, matches } from '../data/sample-bids';

const mine = BIDS.filter((b) => matches(b, 'concrete', 60));
const others = BIDS.filter((b) => !matches(b, 'concrete', 60)).slice(0, 6);
const rows = [...mine, ...others].sort((a, b) => a.dueInDays - b.dueInDays);
---

<figure class="sheet" data-sheet aria-labelledby="sheet-cap">
  <div class="sheet-head">
    <span class="sign text-xl">New public bids this week</span>
    <span class="tabular text-sm whitespace-nowrap text-slate">{BIDS.length} posted on 8 sites</span>
  </div>
  <ol class="sheet-rows">
    {
      rows.map((b) => (
        <li class:list={['sheet-row', { 'is-mine': matches(b, 'concrete', 60) }]}>
          <span class="sheet-title">{b.title}</span>
          <span class="sheet-agency">{b.agency}</span>
        </li>
      ))
    }
  </ol>
  <figcaption id="sheet-cap" class="sheet-cap">
    <span class="sheet-flag" aria-hidden="true"></span>
    Flagged: the {mine.length} concrete jobs within 60 miles of Raleigh. Sample data.
  </figcaption>
</figure>

<script>
  const sheet = document.querySelector<HTMLElement>('[data-sheet]');
  if (sheet) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    sheet.classList.add('is-ready');
    window.setTimeout(() => sheet.classList.add('is-sorted'), reduce ? 0 : 900);
  }
</script>

<style>
  .sheet {
    background: var(--color-sheet);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    padding: 1rem 0 0.75rem;
    box-shadow: 0 18px 40px -26px rgb(19 36 59 / 0.5);
  }
  .sheet-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0 1rem 0.75rem;
    border-bottom: 2px solid var(--color-ink);
  }
  .sheet-row {
    display: grid;
    grid-template-columns: 1fr;
    padding: 0.45rem 1rem 0.45rem 0.85rem;
    border-left: 5px solid transparent;
    border-bottom: 1px solid var(--color-rule-soft);
    transition:
      opacity 500ms ease,
      background-color 500ms ease,
      border-color 500ms ease;
  }
  .sheet-title {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sheet-agency { font-size: 0.8125rem; color: var(--color-slate); }

  /* Sorted state. Without JS the sheet just shows sorted. */
  /* "Not yours" rows fade to a lighter grey that still passes 4.5:1 on white. */
  .sheet-title, .sheet-agency { transition: color 500ms ease; transition-delay: inherit; }
  .sheet:not(.is-ready) .sheet-row:not(.is-mine) :is(.sheet-title, .sheet-agency),
  .sheet.is-sorted .sheet-row:not(.is-mine) :is(.sheet-title, .sheet-agency) {
    color: #647487;
    font-weight: 400;
  }
  .sheet:not(.is-ready) .sheet-row.is-mine,
  .sheet.is-sorted .sheet-row.is-mine {
    border-left-color: var(--color-flag);
    background: var(--color-flag-wash);
  }
  .sheet.is-sorted .sheet-row:nth-child(2) { transition-delay: 60ms; }
  .sheet.is-sorted .sheet-row:nth-child(3) { transition-delay: 120ms; }
  .sheet.is-sorted .sheet-row:nth-child(4) { transition-delay: 180ms; }
  .sheet.is-sorted .sheet-row:nth-child(5) { transition-delay: 240ms; }
  .sheet.is-sorted .sheet-row:nth-child(6) { transition-delay: 300ms; }
  .sheet.is-sorted .sheet-row:nth-child(n + 7) { transition-delay: 360ms; }

  .sheet-cap {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.75rem 1rem 0;
    font-size: 0.875rem;
    color: var(--color-slate);
    opacity: 1;
    transition: opacity 400ms ease 700ms;
  }
  .sheet.is-ready:not(.is-sorted) .sheet-cap { opacity: 0; }
  .sheet-flag {
    width: 0.8rem;
    height: 0.8rem;
    flex: none;
    background: var(--color-flag);
    border-radius: 2px;
  }

  @media (max-width: 767px) {
    .sheet-row:nth-child(n + 8) { display: none; }
  }
</style>
